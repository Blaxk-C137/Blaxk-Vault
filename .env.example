# ---------------------------------------------------------------------------
# BlaxkVault — environment template.
#
#   cp .env.example .env      then edit .env
#
# Comments live on their own lines so this file can be copied verbatim without
# any risk of a trailing comment being read as part of a value. The loader does
# handle inline comments too, but keeping them out of the values is one less way
# to be surprised.
#
# Everything here is optional: with no .env at all, BlaxkVault runs in
# development on 127.0.0.1 with a sample catalogue, and stores everything under
# ./data and ./media.
#
# .env is git-ignored. Never commit real keys.
# ---------------------------------------------------------------------------

# --- Server ----------------------------------------------------------------

NODE_ENV=production

# Listening address. Leave this line commented out for the sensible default:
# 127.0.0.1 in development (this machine only), 0.0.0.0 in production
# (container/preview friendly). Set it explicitly to override.
# HOST=0.0.0.0
# HOST=127.0.0.1
PORT=3000

# Required for any non-loopback access. Generate one with: openssl rand -hex 32
# Empty means "loopback only"; the server generates a temporary token and warns
# if it is exposed beyond loopback without one.
BLAXKVAULT_ACCESS_TOKEN=

# DANGER: true disables authentication entirely. Only for a server behind a
# trusted local reverse proxy (e.g. a private sandbox preview URL) that no
# untrusted client can reach.
BLAXKVAULT_ALLOW_UNAUTHENTICATED=false

# CSP frame-ancestors. 'self' keeps the UI un-frameable by other origins.
BLAXKVAULT_FRAME_ANCESTORS='self'

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Blank = pretty lines in development, JSON in production when output is piped.
# Force it with "pretty" or "json".
LOG_FORMAT=

DATABASE_URL=./data/blaxkvault.db

# --- Metadata provider (discovery only — TMDB hosts no video files) ---------
# Free key: https://developer.themoviedb.org/docs  (attribution required)
TMDB_API_KEY=
TMDB_REGION=NG
TMDB_LANGUAGE=en-US
TMDB_CACHE_TTL_SECONDS=3600

# --- Where-to-watch provider (availability listings only, never files) ------
# https://www.watchmode.com/ — verify pricing/quota/Nigeria coverage before use
WATCHMODE_API_KEY=
WATCHMODE_REGION=NG

# --- Download engine --------------------------------------------------------
# native  = built-in Node HTTP(S) worker (zero external binaries, default)
# aria2   = forward to a localhost aria2c JSON-RPC daemon (opt-in)
DOWNLOAD_ENGINE=native
ARIA2_RPC_URL=http://127.0.0.1:6800/jsonrpc
ARIA2_RPC_SECRET=

DOWNLOAD_DIR=./media/BlaxkVault-Media

MAX_CONCURRENT_DOWNLOADS=2

# Hard cap per job in bytes. 0 = unlimited.
MAX_DOWNLOAD_BYTES=0

# 0 = unlimited.
BANDWIDTH_LIMIT_KBPS=0

CONNECT_TIMEOUT_MS=15000
IDLE_TIMEOUT_MS=20000
MAX_REDIRECTS=5

# --- Media tooling (optional; detected at runtime) --------------------------
# Real duration/codec/resolution reads. Without it, sizes are reported and the
# rest is honestly marked unknown.
FFPROBE_PATH=ffprobe

# Only used for permitted local processing.
FFMPEG_PATH=ffmpeg

# --- Library / safety -------------------------------------------------------

# Extra folders to index. Leave EMPTY to index only the download directory,
# which makes library paths match the on-disk layout exactly. Point at existing
# collections with absolute paths, comma-separated, e.g.
#   MEDIA_ROOTS=/srv/films,/srv/series
# Note: ".ts" means MPEG transport stream here, so do not point a root at a
# source-code tree.
MEDIA_ROOTS=

# Keep false: this is the SSRF guard (blocks loopback, LAN and metadata hosts).
ALLOW_PRIVATE_ADDRESSES=false

# Optional comma-separated allowlist limiting which hosts a direct URL may use.
ALLOWED_HTTP_HOSTS=
